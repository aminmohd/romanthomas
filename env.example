#--------------------------------------------------------------------
# Copy to .env and set real values locally. Never commit .env.
# All application credentials are read from .env only.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8085/'
app.indexPage =
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 
database.default.database = 
database.default.username = 
database.default.password =
database.default.DBDriver = 
database.default.DBPrefix =
database.default.port = 
database.default.charset = 
database.default.DBCollat = 

logger.threshold = 9

#--------------------------------------------------------------------
# SMTP (required for outbound mail)
# email.SMTPUser is usually the mailbox address; SMTPPass = app password
#--------------------------------------------------------------------

email.protocol = 
email.SMTPHost = 
email.SMTPPort = 
email.SMTPUser =
email.SMTPPass =
email.SMTPCrypto = 
email.mailType = 
email.charset = 
email.SMTPTimeout = 

email.fromEmail =
email.fromName = 'Roman Thomas'
email.replyTo =

email.testMailFrom =
email.testMailTo =
email.testMailReplyTo =
email.welcomeTestRecipient =

